# Langfuse
EVALUATOR_HARNESS_LIVE=0
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional live smoke routing
# Optional override for ad hoc/manual Human Annotation Queue routing.
# Project-managed queues do not require this value.
LANGFUSE_ANNOTATION_QUEUE_ID=

# Azure OpenAI via Azure AD client credentials and APIM subscription key
EDAV_TENANT_ID=00000000-0000-0000-0000-000000000000
EDAV_CLIENT_ID=00000000-0000-0000-0000-000000000000
EDAV_CLIENT_SECRET=replace-with-local-secret
EDAV_SCOPE_TOKEN_AUDIENCE=https://cognitiveservices.azure.com/.default
EDAV_SUBSCRIPTION_KEY=replace-with-local-subscription-key
EDAV_AZURE_OPENAI_API_VERSION=2024-12-01-preview
EDAV_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
